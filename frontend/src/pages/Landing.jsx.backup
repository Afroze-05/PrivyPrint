    }}
    className="group relative bg-gradient-to-br from-orange-50/10 to-orange-100/5 p-8 border border-orange-200/20 hover:border-orange-400/40 transition-all duration-500 overflow-hidden backdrop-blur-sm rounded-2xl"
    style={{ 
      clipPath: "polygon(0 0, calc(100% - 22px) 0, 100% 22px, 100% 100%, 0 100%)",
