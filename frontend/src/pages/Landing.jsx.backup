            {/* Enhanced CTA button with premium effects */}
            <PremiumButton
              onClick={() => navigate("/home")}
              className="mt-8 px-16 py-6 font-black uppercase tracking-[0.4em] text-white text-sm rounded-2xl bg-gradient-to-r from-orange-500 to-orange-600 border border-orange-500/20"
            >
              Start System
            </PremiumButton>
          </motion.div>

          {/* Enhanced scroll hint with premium animation */}
          <motion.div
            className="absolute bottom-12 flex flex-col items-center gap-3 text-orange-400/50 cursor-pointer"
            animate={{ y: [0, 10, 0] }}
            transition={{ duration: 2.2, repeat: Infinity, ease: "easeInOut" }}
            whileHover={{ scale: 1.1, color: "rgba(255, 107, 53, 0.8)" }}
          >
            <motion.span 
              className="text-[10px] tracking-[0.55em] uppercase font-black"
              animate={{ opacity: [0.5, 1, 0.5] }}
              transition={{ duration: 3, repeat: Infinity }}
            >
              Scroll to Explore
            </motion.span>
            <motion.div
