    <motion.div
      className="absolute w-80 h-80 rounded-full bg-orange-600/15 blur-3xl"
      animate={{
        x: [0, -80, 60, 0],
        y: [0, 80, -40, 0],
        scale: [1, 0.9, 1.1, 1],
      }}
      transition={{ duration: 10, repeat: Infinity, ease: "easeInOut", delay: 2 }}
      style={{ bottom: "20%", right: "15%" }}
    />
    <motion.div
      className="absolute w-72 h-72 rounded-full bg-yellow-500/10 blur-3xl"
      animate={{
        x: [0, 60, -30, 0],
        y: [0, -60, 30, 0],
        scale: [1, 1.3, 0.7, 1],
      }}
      transition={{ duration: 15, repeat: Infinity, ease: "easeInOut", delay: 4 }}
      style={{ top: "50%", left: "50%" }}
    />
