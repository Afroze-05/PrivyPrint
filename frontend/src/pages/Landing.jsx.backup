          "radial-gradient(circle at 50% 20%, rgba(255, 107, 53, 0.3) 0%, transparent 50%)",
          "radial-gradient(circle at 50% 80%, rgba(255, 107, 53, 0.3) 0%, transparent 50%)",
          "radial-gradient(circle at 20% 50%, rgba(255, 107, 53, 0.3) 0%, transparent 50%)",
        ]
      }}
      transition={{ duration: 8, repeat: Infinity, ease: "easeInOut" }}
    />
    
    {/* Floating blurred blobs */}
    <motion.div
      className="absolute w-96 h-96 rounded-full bg-orange-500/20 blur-3xl"
      animate={{
        x: [0, 100, -50, 0],
        y: [0, -100, 50, 0],
        scale: [1, 1.2, 0.8, 1],
      }}
      transition={{ duration: 12, repeat: Infinity, ease: "easeInOut" }}
      style={{ top: "10%", left: "10%" }}
