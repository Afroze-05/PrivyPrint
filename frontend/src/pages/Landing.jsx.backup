);

/* ── Enhanced Section with stack effect ── */
const StackedSection = ({ children, index, totalSections, ...props }) => {
  const ref = useRef(null);
  const isInView = useInView(ref, { amount: 0.3 });
  const controls = useAnimation();
  
  useEffect(() => {
    if (isInView) {
      controls.start("active");
    } else {
      controls.start("initial");
    }
  }, [isInView, controls]);
  
  return (
    <motion.section
      ref={ref}
      initial="initial"
      animate={controls}
      variants={{
        initial: {
          opacity: 0,
          translateY: 100,
          scale: 0.95,
        },
        active: {
          opacity: 1,
          translateY: 0,
          scale: 1,
        },
        exit: {
          opacity: 0.6,
          scale: 0.96,
        }
      }}
      transition={{
        duration: 0.6,
        ease: [0.22, 1, 0.36, 1],
        delay: index * 0.1
      }}
      className="relative mx-auto my-10 max-w-6xl rounded-3xl bg-orange-50/5 backdrop-blur-xl shadow-2xl border border-orange-500/10 overflow-hidden"
      style={{
        boxShadow: "0 20px 60px rgba(0, 0, 0, 0.6), 0 0 120px rgba(255, 107, 53, 0.1)",
        transformStyle: "preserve-3d"
      }}
      {...props}
    >
      {/* Subtle border glow */}
      <motion.div
        className="absolute inset-0 rounded-3xl"
        style={{
          background: "linear-gradient(45deg, transparent, rgba(255, 107, 53, 0.1), transparent)",
        }}
        animate={{
          opacity: [0.5, 1, 0.5],
        }}
        transition={{ duration: 3, repeat: Infinity }}
      />
      
      {children}
    </motion.section>
  );
};

/* ── Enhanced Button with premium effects ── */
const PremiumButton = ({ children, onClick, className = "", ...props }) => (
  <motion.button
    onClick={onClick}
    className={`relative overflow-hidden group ${className}`}
    whileHover={{ 
      scale: 1.05,
      boxShadow: "0 20px 40px rgba(255, 107, 53, 0.3), 0 0 60px rgba(255, 107, 53, 0.1)",
    }}
    whileTap={{ scale: 0.98 }}
    transition={{ type: "spring", stiffness: 400, damping: 10 }}
    {...props}
  >
    {/* Animated shimmer effect */}
    <motion.div
      className="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent"
      animate={{
        x: ["-100%", "100%"],
      }}
      transition={{
        duration: 2,
        repeat: Infinity,
        ease: "linear",
      }}
    />
    
    {/* Glow border on hover */}
    <motion.div
      className="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"
      style={{
        background: "linear-gradient(45deg, rgba(255, 107, 53, 0.3), transparent, rgba(255, 107, 53, 0.3))",
        filter: "blur(1px)",
      }}
    />
    
    <span className="relative z-10 flex items-center gap-2">
      {children}
      <motion.div
        initial={{ x: 0 }}
        whileHover={{ x: 4 }}
        transition={{ duration: 0.2 }}
      >
        <ArrowRight className="w-4 h-4" />
      </motion.div>
    </span>
  </motion.button>
);

/* ── Enhanced Feature card with premium animations ── */
const FeatureCard = ({ icon, title, text, index }) => (
  <motion.div
    initial={{ opacity: 0, y: 50, rotateX: 15, scale: 0.9 }}
    whileInView={{ opacity: 1, y: 0, rotateX: 0, scale: 1 }}
    transition={{ 
      delay: index * 0.15, 
