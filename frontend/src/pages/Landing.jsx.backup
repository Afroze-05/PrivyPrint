function Landing() {
  const navigate = useNavigate();
  const targetRef = useRef(null);
  const [mounted, setMounted] = useState(false);
  const [scrolled, setScrolled] = useState(false);

  useEffect(() => { 
    setMounted(true); 
    
    const handleScroll = () => {
      setScrolled(window.scrollY > 50);
    };
    
    window.addEventListener('scroll', handleScroll);
    return () => window.removeEventListener('scroll', handleScroll);
  }, []);

  const { scrollYProgress } = useScroll({
    target: targetRef,
    offset: ["start start", "end end"],
  });

  const shutterSpring = { mass: 1.5, stiffness: 90, damping: 14, restDelta: 0.001 };

  const rawY1 = useTransform(scrollYProgress, [0, 0.33], ["-100%", "0%"]);
  const rawY2 = useTransform(scrollYProgress, [0.33, 0.66], ["-100%", "0%"]);
  const rawY3 = useTransform(scrollYProgress, [0.66, 1], ["-100%", "0%"]);

  const shutter1Y = useSpring(rawY1, shutterSpring);
  const shutter2Y = useSpring(rawY2, shutterSpring);
  const shutter3Y = useSpring(rawY3, shutterSpring);
  
  // Enhanced scroll-based animations
  const opacity = useTransform(scrollYProgress, [0, 0.25, 0.75, 1], [1, 0.8, 0.6, 0.4]);
  const scale = useTransform(scrollYProgress, [0, 0.5, 1], [1, 0.98, 0.95]);
  const parallaxY = useTransform(scrollYProgress, [0, 1], [0, -50]);

  const features = [
    {
      icon: <Shield className="w-7 h-7 text-[var(--accent)]" />,
      title: "Encrypted Node",
      text: "Data packets are shredded post-transmission.",
    },
    {
      icon: <Printer className="w-7 h-7 text-[var(--accent)]" />,
      title: "Physical Link",
      text: "Release only via authenticated proximity.",
    },
    {
      icon: <Lock className="w-7 h-7 text-[var(--accent)]" />,
      title: "Zero Cache",
      text: "No residual memory left on hardware.",
    },
  ];

  return (
    <div
      ref={targetRef}
      className="relative min-h-screen bg-black text-white overflow-x-hidden font-sans"
      style={{ 
        scrollBehavior: 'smooth',
        scrollSnapType: 'y mandatory'
      }}
    >
      {/* Enhanced animated background */}
      <AnimatedBackground />
      
      {/* Enhanced scroll-responsive navbar */}
      <motion.nav
        className={`fixed top-0 left-0 right-0 z-50 transition-all duration-300 ${
          scrolled 
            ? 'bg-black/80 backdrop-blur-xl border-b border-orange-500/20' 
            : 'bg-transparent'
        }`}
        initial={{ y: -100 }}
        animate={{ y: 0 }}
        transition={{ duration: 0.6 }}
      >
        <div className="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
          <motion.div 
            className="flex items-center gap-2"
            whileHover={{ scale: 1.05 }}
            transition={{ duration: 0.2 }}
          >
            <Cpu className="w-5 h-5 text-orange-500" />
            <span className="text-sm font-black tracking-wider text-orange-500 uppercase">
              PrivyPrint OS
            </span>
          </motion.div>
          
          <div className="flex items-center gap-4">
            {['Features', 'Security', 'About'].map((item, i) => (
              <motion.button
                key={item}
                className="text-xs font-medium text-white/60 hover:text-orange-400 transition-colors"
                whileHover={{ y: -2 }}
                transition={{ duration: 0.2 }}
              >
                {item}
              </motion.button>
            ))}
          </div>
        </div>
      </motion.nav>
      
      <div className="relative">
        {/* ═══════════════════════════════════
            HERO SECTION - Enhanced
        ═══════════════════════════════════ */}
        <section className="relative min-h-screen flex items-center justify-center px-6 scroll-snap-start">
          <NoiseSVG />
          <GridDots color="rgba(255, 107, 53, 0.3)" opacity={0.15} />
          <ScanLine />
          <GlowOrb color="#FF6B35" size={480} top="-8%" left="-6%" delay={0} />
          <GlowOrb color="#FF8555" size={380} top="35%" left="62%" delay={2} />
          <GlowOrb color="#D97706" size={260} top="60%" left="18%" delay={4} />

          {/* Enhanced edge rules with glow */}
          <motion.div 
            className="absolute top-0 left-0 right-0 h-[1px] bg-gradient-to-r from-transparent via-orange-500/50 to-transparent"
            animate={{ opacity: [0.5, 1, 0.5] }}
            transition={{ duration: 3, repeat: Infinity }}
          />
          <motion.div 
            className="absolute bottom-0 left-0 right-0 h-[1px] bg-gradient-to-r from-transparent via-orange-600/50 to-transparent"
            animate={{ opacity: [0.5, 1, 0.5] }}
            transition={{ duration: 3, repeat: Infinity, delay: 1.5 }}
          />
          <div className="absolute top-0 left-0 bottom-0 w-[1px] bg-gradient-to-b from-orange-500/30 to-transparent" />

          {/* Enhanced system tag with animations */}
